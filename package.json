{
  "name": "dungeon-deck-recorder",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "download:ml-model": "powershell -ExecutionPolicy Bypass -File ./scripts/download-ml-model.ps1",
    "test:mvp:web": "npm run type-check && npm run build",
    "deploy:web:vercel-team": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-vercel-team.ps1",
    "mobile:sync:ios": "npm run build && npx cap sync ios",
    "mobile:sync:android": "npm run build && npx cap sync android",
    "android:test": "cd android && gradlew.bat test",
    "android:build:debug": "cd android && gradlew.bat assembleDebug",
    "android:build:release": "cd android && gradlew.bat bundleRelease",
    "android:build-apk": "powershell -ExecutionPolicy Bypass -File ./scripts/build-apk.ps1",
    "android:deploy": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-android-device.ps1",
    "format": "prettier --write .",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.1",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "svelte": "^5.55.0",
    "typescript": "^5.4.5",
    "vite": "^8.0.3"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^6.0.1",
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.0.1",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/haptics": "^6.0.3",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@xenova/transformers": "^2.17.2",
    "capacitor-audio-transcriber": "file:./capacitor-audio-transcriber",
    "capacitor-voice-recorder": "^6.0.3",
    "compromise": "^14.14.0",
    "onnxruntime-web": "^1.26.0"
  },
  "optionalDependencies": {
    "@capacitor/android": "^6.0.1",
    "@capacitor/ios": "^6.0.1"
  }
}
