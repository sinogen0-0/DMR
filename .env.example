# Environment Configuration Template
# Copy this file to .env.local and update values as needed

# General
VITE_APP_TITLE=Dungeon Deck Recorder
VITE_APP_VERSION=0.0.1

# Feature Flags
VITE_ENABLE_AUDIO_RECORDING=true
VITE_ENABLE_TRANSCRIPTION=true
VITE_ENABLE_EXTRACTION=true

# Storage
VITE_DB_NAME=dungeon_deck_recorder
VITE_STORAGE_QUOTA=1073741824

# Merge Settings
VITE_DEFAULT_MERGE_THRESHOLD=90

# Audio Settings
VITE_DEFAULT_AUDIO_CODEC=flac
VITE_AUDIO_SAMPLE_RATE=16000
VITE_AUDIO_CHANNELS=1
